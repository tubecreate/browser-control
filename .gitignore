# Handle everything as ignored by default
*

# Allow directories
!*/

# Allow specific file types
!*.js
!*.json
!*.md
!*.html
!*.gitignore
!*.py
!LICENSE

# Explicitly ignore heavy folders (just in case)
node_modules/
profiles/
dist/
browser/
data/
.git/
__pycache__/
.DS_Store
*.log

# === SENSITIVE DATA - Never push ===
auth_status.json
*_agent.json
agent.json
*agent*.json
tasks/
